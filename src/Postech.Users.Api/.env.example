# ── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=postech_users;Username=postgres;Password=postgres

# ── AWS (general) ─────────────────────────────────────────────────────────────
AWS__Region=us-east-1
AWS__ServiceURL=http://localhost:4566   # LocalStack endpoint – remove for real AWS
AWS__AccessKey=test                     # LocalStack dummy key  – remove for real AWS
AWS__SecretKey=test                     # LocalStack dummy secret – remove for real AWS
AWS__SnsTopicArn=arn:aws:sns:us-east-1:000000000000:user-events

# ── Cognito ───────────────────────────────────────────────────────────────────
CognitoSettings__Region=us-east-1
CognitoSettings__UserPoolId=us-east-1_XXXXXXXXX
CognitoSettings__ClientId=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── MassTransit (v9 requires a commercial license for non-community transports)
# Leave blank to fall back to the in-memory bus (local/dev only)
MassTransit__License=
MassTransit__LicensePath=

